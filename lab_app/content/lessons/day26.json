      "intro_md": "반복문 없이 재귀만으로 자릿수 합을 구합니다.",
      "exercise_ids": [
        "d26_code_1"
      ]
    },
    {
      "type": "summary",
      "minutes": 2,
      "title": "오늘의 핵심 정리",
      "points": [
        "재귀 = 종료 조건 + 더 작은 문제로 자기 호출.",
        "종료 조건이 없으면 `RecursionError`.",
        "리스트는 `items[0]`과 `items[1:]`로 나눠 재귀할 수 있다.",
        "재귀는 반복문으로 바꿀 수도 있다. 더 읽기 쉬운 쪽을 고른다."
      ],
      "quiz": [
        {
          "id": "d26_summary_q1",
          "question_md": "`def f(n): return 0 if n == 0 else n + f(n - 1)`일 때 `f(4)`는?",
          "choices": [
            "4",
            "6",
            "10",
            "오류"
          ],
          "answer_index": 2,
          "explanation_md": "4 + 3 + 2 + 1 + 0 = 10."
        },
        {
          "id": "d26_summary_q2",
          "question_md": "재귀 함수에 반드시 필요한 것은?",
          "choices": [
            "반복문",
            "전역 변수",
            "종료 조건",
            "lambda"
          ],
          "answer_index": 2,
          "explanation_md": "종료 조건이 있어야 호출이 멈춥니다."
        }
      ]
    }
