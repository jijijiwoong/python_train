          "call": {
            "args": [
              10
            ]
          },
          "expect": {
            "return": 55
          }
        },
        {
          "id": "h1",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              1
            ]
          },
          "expect": {
            "return": 1
          }
        },
        {
          "id": "h2",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              2
            ]
          },
          "expect": {
            "return": 1
          }
        },
        {
          "id": "h3",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              15
            ]
          },
          "expect": {
            "return": 610
          }
        }
      ],
      "hints": [
        "n이 0이나 1이면 n 자신이 답입니다. 이 경우를 하나의 비교식으로 쓰세요.",
        "두 단계 전의 피보나치 수는 n에서 얼마를 뺀 값인가요?"
      ],
      "solution": "def fib(n):\n    if n <= 1:\n        return n\n    return fib(n - 1) + fib(n - 2)\n"
    },
    {
      "id": "d26_code_1",
      "kind": "coding",
      "title": "자릿수의 합 (재귀)",
      "prompt_md": "0 이상의 정수 `n`의 각 자릿수를 더한 값을 **재귀**로 반환하세요. 음수이면 `ValueError`를 발생시킵니다.\n\n- `for`/`while`, `sum()`, `str()`은 사용할 수 없습니다. `n % 10`(마지막 자리)과 `n // 10`(나머지 자리)을 이용하세요.\n\n예: `sum_digits(1234)` → `10`",
      "concepts": [
        "recursion",
        "operator",
        "exception"
      ],
      "difficulty": 2,
      "required": true,
      "starter_code": "def sum_digits(n):\n    # 여기에 코드를 작성하세요\n    pass\n",
      "entry": {
        "mode": "function",
        "name": "sum_digits"
      },
      "tests": [
        {
          "id": "t1",
          "hidden": false,
          "description": "네 자리",
          "call": {
            "args": [
              1234
            ]
          },
          "expect": {
            "return": 10
          }
        },
        {
          "id": "t2",
          "hidden": false,
          "description": "0",
          "call": {
            "args": [
              0
            ]
          },
          "expect": {
            "return": 0
          }
        },
        {
          "id": "t3",
          "hidden": false,
          "description": "음수",
          "call": {
            "args": [
              -5
            ]
          },
          "expect": {
            "raises": "ValueError"
          }
        },
        {
          "id": "h1",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              9
            ]
          },
          "expect": {
            "return": 9
          }
        },
        {
          "id": "h2",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              99999
            ]
          },
          "expect": {
            "return": 45
          }
        },
        {
          "id": "h3",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              1000000
            ]
          },
          "expect": {
            "return": 1
          }
        }
      ],
      "hints": [
        "음수 검사를 먼저 하세요. 종료 조건은 \"한 자리 수\"일 때입니다.",
        "1234 → 4 + (123의 자릿수 합)처럼 마지막 자리와 나머지로 나눕니다.",
        "마지막 자리는 `n % 10`, 나머지 자리는 `n // 10`."
      ],
      "solution": "def sum_digits(n):\n    if n < 0:\n        raise ValueError(\"0 이상의 정수만 가능합니다\")\n    if n < 10:\n        return n\n    return n % 10 + sum_digits(n // 10)\n",
      "checks": {
        "forbidden_syntax": [
          "for",
          "while"
        ],
        "forbidden_calls": [
          "sum",
          "str",
          "map"
        ],
