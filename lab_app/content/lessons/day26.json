  "exercises": [
    {
      "id": "d26_fill_1",
      "kind": "fill_blank",
      "title": "피보나치 수",
      "prompt_md": "n번째 피보나치 수를 **재귀**로 반환하세요.\n\n예: `fib(0)` → `0`, `fib(1)` → `1`, `fib(10)` → `55`",
      "concepts": [
        "recursion"
      ],
      "difficulty": 1,
      "required": true,
      "starter_code": "def fib(n):\n    if n ____ 1:\n        return n\n    return fib(n - 1) + fib(n ____ 2)\n",
      "entry": {
        "mode": "function",
        "name": "fib"
      },
      "tests": [
