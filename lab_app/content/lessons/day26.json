      "quiz": [
        {
          "id": "d26_review_q1",
          "question_md": "점수(p[1]) 내림차순, 이름(p[0]) 오름차순 정렬 key는?",
          "choices": [
            "`lambda p: (p[1], p[0])`",
            "`lambda p: (-p[1], p[0])`",
            "`lambda p: (p[0], -p[1])`",
            "`lambda p: -p`"
          ],
          "answer_index": 1,
          "explanation_md": "내림차순으로 바꿀 숫자 기준에만 `-`를 붙입니다."
        }
      ]
