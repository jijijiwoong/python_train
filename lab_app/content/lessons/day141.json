    {
      "id": "d141_code_1",
      "kind": "coding",
      "title": "평균 이미지",
      "prompt_md": "digits에서 숫자 `digit`인 이미지만 골라 `[장수, 평균 이미지의 전체 평균(소수 넷째 자리), 평균 이미지에서 가장 밝은 칸의 (행, 열)]`을 반환하세요. 픽셀은 원래 값(0~16) 그대로 씁니다.",
      "concepts": [
        "image_tensor",
        "tensor_ops"
      ],
      "difficulty": 2,
      "required": true,
      "starter_code": "import torch\nfrom sklearn.datasets import load_digits\n\n\ndef digit_profile(digit):\n    # 여기에 코드를 작성하세요\n    pass\n",
      "entry": {
        "mode": "function",
        "name": "digit_profile"
      },
      "tests": [
        {
