    {
      "id": "d141_fill_1",
      "kind": "fill_blank",
      "title": "이미지 텐서",
      "prompt_md": "digits 앞 `n`장을 (N, 1, 8, 8) 텐서로 바꾸고 16으로 나누어 `[모양 리스트, 최댓값]`을 반환하세요.",
      "concepts": [
        "image_tensor"
      ],
      "difficulty": 1,
      "required": true,
      "starter_code": "import torch\nfrom sklearn.datasets import load_digits\n\n\ndef to_images(n):\n    images = load_digits().images[:n]\n    x = torch.tensor(images, dtype=torch.float32).____ / ____\n    return [list(x.shape), x.max().item()]\n",
      "entry": {
        "mode": "function",
        "name": "to_images"
      },
      "tests": [
        {
          "id": "t1",
          "hidden": false,
          "description": "기본",
          "call": {
            "args": [
              5
            ]
          },
          "expect": {
            "return": [
              [
                5,
                1,
                8,
                8
              ],
              1.0
            ]
          },
          "compare": {
            "mode": "float",
            "tol": 0.0001
          }
        },
        {
          "id": "h1",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              100
            ]
          },
          "expect": {
            "return": [
              [
                100,
                1,
                8,
                8
              ],
              1.0
            ]
          },
          "compare": {
            "mode": "float",
            "tol": 0.0001
          }
        }
      ],
      "hints": [
        "채널 차원을 1번 위치에 추가하는 메서드입니다.",
        "digits의 최대 밝기로 나눕니다."
      ],
      "solution": "import torch\nfrom sklearn.datasets import load_digits\n\n\ndef to_images(n):\n    images = load_digits().images[:n]\n    x = torch.tensor(images, dtype=torch.float32).unsqueeze(1) / 16\n    return [list(x.shape), x.max().item()]\n",
      "time_limit_sec": 60
