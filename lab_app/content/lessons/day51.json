      "starter_code": "import numpy as np\n\n\ndef normalize(values):\n    a = np.array(values, dtype=float)\n    return (a - a.____()) / (a.max() ____ a.min())\n",
      "entry": {
        "mode": "function",
        "name": "normalize"
      },
      "tests": [
        {
          "id": "t1",
