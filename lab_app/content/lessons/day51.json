      "concepts": [
        "numpy_ops"
      ],
      "difficulty": 2,
      "required": true,
      "starter_code": "import numpy as np\n\n\ndef bmi(heights_cm, weights_kg):\n    # 여기에 코드를 작성하세요\n    pass\n",
      "entry": {
