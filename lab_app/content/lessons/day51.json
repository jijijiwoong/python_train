          "description": "",
          "call": {
            "args": [
              [
                3,
                1,
                2
              ]
            ]
          },
          "expect": {
            "return": [
              1.0,
              0.0,
              0.5
            ]
          }
        },
        {
          "id": "h2",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              [
                -2,
                2
              ]
            ]
          },
          "expect": {
            "return": [
              0.0,
              1.0
            ]
          }
        }
      ],
      "hints": [
        "가장 작은 값을 구하는 배열 메서드입니다.",
        "범위(최대와 최소의 차이)를 구하는 연산자입니다."
      ],
      "solution": "import numpy as np\n\n\ndef normalize(values):\n    a = np.array(values, dtype=float)\n    return (a - a.min()) / (a.max() - a.min())\n",
