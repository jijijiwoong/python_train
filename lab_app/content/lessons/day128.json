      ],
      "hints": [
        "음수를 0으로 만드는 함수입니다.",
        "0~1로 눌러 주는 S자 함수입니다."
      ],
      "solution": "import torch\n\n\ndef activate(values):\n    x = torch.tensor(values, dtype=torch.float32)\n    return [torch.relu(x).tolist(), torch.sigmoid(x).round(decimals=4).tolist()]\n",
      "time_limit_sec": 60
