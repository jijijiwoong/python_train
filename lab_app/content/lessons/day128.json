    {
      "id": "d128_code_1",
      "kind": "coding",
      "title": "다층 신경망",
      "prompt_md": "`torch.manual_seed(seed)` 후 `nn.Sequential(nn.Linear(2, 4), nn.ReLU(), nn.Linear(4, 1))`을 만들어 입력 `rows`의 출력을 펼친 리스트(소수 넷째 자리)로 반환하세요. 기울기가 필요 없으니 `torch.no_grad()` 안에서 계산합니다.",
      "concepts": [
        "activation",
        "nn_linear"
      ],
      "difficulty": 2,
      "required": true,
      "starter_code": "import torch\nfrom torch import nn\n\n\ndef mlp_output(seed, rows):\n    # 여기에 코드를 작성하세요\n    pass\n",
      "entry": {
        "mode": "function",
        "name": "mlp_output"
      },
      "tests": [
        {
          "id": "t1",
          "hidden": false,
          "description": "기본",
          "call": {
            "args": [
              0,
              [
                [
                  1,
                  2
                ],
                [
                  0,
                  0
                ]
              ]
            ]
          },
          "expect": {
            "return": [
              -0.1143,
              0.1357
            ]
          },
          "compare": {
            "mode": "float",
            "tol": 0.0001
          }
        },
        {
          "id": "h1",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              3,
              [
                [
                  -1,
                  1
                ],
                [
                  2,
                  2
                ],
                [
                  0.5,
                  0
                ]
              ]
            ]
          },
          "expect": {
            "return": [
              -0.4549,
              -0.4008,
              -0.3885
            ]
          },
          "compare": {
            "mode": "float",
            "tol": 0.0001
          }
        }
      ],
      "hints": [
        "층을 만드는 순서가 무작위 초깃값을 결정하니 문제와 같은 순서로 만드세요.",
        "출력은 (n, 1) 모양이라 `flatten()`으로 펼칩니다."
      ],
      "solution": "import torch\nfrom torch import nn\n\n\ndef mlp_output(seed, rows):\n    torch.manual_seed(seed)\n    model = nn.Sequential(nn.Linear(2, 4), nn.ReLU(), nn.Linear(4, 1))\n    with torch.no_grad():\n        out = model(torch.tensor(rows, dtype=torch.float32))\n    return [round(v, 4) for v in out.flatten().tolist()]\n",
      "time_limit_sec": 60
    }
