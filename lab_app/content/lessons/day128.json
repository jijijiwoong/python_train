      "starter_code": "import torch\n\n\ndef activate(values):\n    x = torch.tensor(values, dtype=torch.float32)\n    return [torch.____(x).tolist(), torch.____(x).round(decimals=4).tolist()]\n",
      "entry": {
        "mode": "function",
        "name": "activate"
      },
      "tests": [
        {
          "id": "t1",
          "hidden": false,
          "description": "기본",
