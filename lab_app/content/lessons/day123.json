          "compare": {
            "mode": "float",
            "tol": 0.0001
          }
        },
        {
          "id": "h1",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              [
                [
                  -1,
                  -2,
                  -3
                ],
                [
                  -1,
                  0,
