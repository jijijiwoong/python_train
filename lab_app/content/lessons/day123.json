            "tol": 0.0001
          }
        }
      ],
      "hints": [
        "행마다의 합은 `sum(dim=1)`입니다.",
        "`argmax().item()`으로 위치를 파이썬 정수로 꺼내세요."
      ],
      "solution": "import numpy as np\nimport torch\n\n\ndef best_row(rows):\n    t = torch.from_numpy(np.array(rows, dtype=float))\n    sums = t.sum(dim=1)\n    idx = sums.argmax().item()\n    return [idx, sums[idx].item()]\n",
      "time_limit_sec": 60
    }
