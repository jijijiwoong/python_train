      "id": "d123_fill_1",
      "kind": "fill_blank",
      "title": "자료형 맞추기",
      "prompt_md": "목록으로 NumPy 배열을 만들고 텐서로 바꾼 뒤 `float32`로 변환해 `[dtype 문자열, 합]`을 반환하세요.",
      "concepts": [
        "tensor",
        "numpy_array"
      ],
      "difficulty": 1,
      "required": true,
      "starter_code": "import numpy as np\nimport torch\n\n\ndef to_float_tensor(values):\n    arr = np.array(values, dtype=float)\n    t = torch.____(arr).____\n    return [str(t.dtype), t.sum().item()]\n",
      "entry": {
        "mode": "function",
        "name": "to_float_tensor"
      },
      "tests": [
        {
          "id": "t1",
          "hidden": false,
          "description": "기본",
          "call": {
            "args": [
              [
                1,
                2,
                3.5
              ]
            ]
          },
          "expect": {
            "return": [
              "torch.float32",
              6.5
            ]
          },
          "compare": {
            "mode": "float",
            "tol": 0.0001
          }
        },
        {
          "id": "h1",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              [
                -1,
                1
              ]
            ]
          },
          "expect": {
            "return": [
              "torch.float32",
              0.0
            ]
          },
          "compare": {
            "mode": "float",
            "tol": 0.0001
          }
        }
      ],
      "hints": [
        "NumPy 배열에서 텐서를 만드는 함수는 `from_…` 형태입니다.",
        "float32로 바꾸는 메서드입니다."
      ],
      "solution": "import numpy as np\nimport torch\n\n\ndef to_float_tensor(values):\n    arr = np.array(values, dtype=float)\n    t = torch.from_numpy(arr).float()\n    return [str(t.dtype), t.sum().item()]\n",
      "time_limit_sec": 60
    },
