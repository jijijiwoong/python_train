      ],
      "solution": "import pandas as pd\n\n\ndef top_name(data):\n    df = pd.DataFrame(data)\n    return df.loc[df[\"점수\"].idxmax(), \"이름\"]\n",
      "time_limit_sec": 15
    },
    {
      "id": "d63_code_1",
      "kind": "coding",
      "title": "성적 분석",
      "prompt_md": "이름·반·국어·수학 데이터를 분석해 딕셔너리를 반환하세요.\n\n- `best`: 총점(국어+수학) 1등의 이름\n- `class_mean`: 반별 총점 평균(소수 첫째 자리 반올림) 딕셔너리\n- `over_150`: 총점이 150 초과인 학생 수",
      "concepts": [
        "pandas_select",
        "pandas_transform",
        "pandas_groupby"
      ],
      "difficulty": 2,
      "required": true,
      "starter_code": "import pandas as pd\n\n\ndef analyze(data):\n    # 여기에 코드를 작성하세요\n    pass\n",
      "entry": {
        "mode": "function",
        "name": "analyze"
      },
      "tests": [
        {
          "id": "t1",
          "hidden": false,
          "description": "학생 표",
          "call": {
            "args": [
              {
                "이름": [
                  "민준",
                  "서연",
                  "지호",
                  "하나",
                  "도윤"
                ],
                "반": [
                  "A",
                  "B",
                  "A",
                  "B",
                  "A"
                ],
                "국어": [
                  85,
                  92,
                  78,
                  66,
                  90
                ],
                "수학": [
                  70,
                  88,
                  95,
                  72,
                  60
                ]
              }
            ]
          },
          "expect": {
            "return": {
              "best": "서연",
              "class_mean": {
                "A": 159.3,
                "B": 159.0
              },
              "over_150": 3
            }
          },
          "compare": {
            "mode": "float",
            "tol": 1e-09
          }
        },
        {
          "id": "h1",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              {
                "이름": [
                  "a",
                  "b"
                ],
                "반": [
                  "X",
                  "X"
                ],
                "국어": [
                  100,
                  50
                ],
                "수학": [
                  51,
                  50
                ]
              }
            ]
          },
          "expect": {
            "return": {
              "best": "a",
              "class_mean": {
                "X": 125.5
              },
              "over_150": 1
            }
          },
          "compare": {
            "mode": "float",
            "tol": 1e-09
          }
        }
      ],
      "hints": [
        "먼저 총점 열을 만드세요.",
        "1등은 `idxmax`, 반별 평균은 `groupby(\"반\")[\"총점\"].mean().round(1).to_dict()`.",
        "개수는 조건 마스크의 `sum()`을 `int()`로."
      ],
      "solution": "import pandas as pd\n\n\ndef analyze(data):\n    df = pd.DataFrame(data)\n    df[\"총점\"] = df[\"국어\"] + df[\"수학\"]\n    best = df.loc[df[\"총점\"].idxmax(), \"이름\"]\n    class_mean = df.groupby(\"반\")[\"총점\"].mean().round(1).to_dict()\n    return {\"best\": best, \"class_mean\": class_mean, \"over_150\": int((df[\"총점\"] > 150).sum())}\n",
      "time_limit_sec": 15
    },
    {
      "id": "d63_code_2",
      "kind": "coding",
      "title": "[도전] 피벗 테이블",
      "prompt_md": "반·성별·점수 데이터로 행 = 반, 열 = 성별인 평균 점수 피벗 테이블(소수 첫째 자리 반올림)을 만들고 `{반: {성별: 평균}}` 딕셔너리로 반환하세요. 값이 없는 칸은 `None`입니다.",
      "concepts": [
        "pandas_groupby",
        "pandas_missing"
      ],
      "difficulty": 3,
      "required": false,
      "starter_code": "import pandas as pd\n\n\ndef pivot(data):\n    # 여기에 코드를 작성하세요\n    pass\n",
      "entry": {
        "mode": "function",
        "name": "pivot"
      },
      "tests": [
        {
          "id": "t1",
          "hidden": false,
          "description": "빈 칸 포함",
          "call": {
            "args": [
              {
                "반": [
                  "A",
                  "A",
                  "B",
                  "B",
                  "A"
                ],
                "성별": [
                  "남",
                  "여",
                  "여",
                  "여",
                  "남"
                ],
                "점수": [
                  80,
                  90,
                  70,
                  75,
                  60
                ]
              }
            ]
          },
          "expect": {
            "return": {
              "A": {
                "남": 70.0,
                "여": 90.0
              },
              "B": {
                "남": null,
                "여": 72.5
              }
            }
          },
          "compare": {
            "mode": "float",
            "tol": 1e-09
          }
        },
        {
          "id": "h1",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              {
                "반": [
                  "C",
                  "C"
                ],
                "성별": [
                  "남",
                  "여"
                ],
                "점수": [
                  10,
                  20
                ]
              }
            ]
          },
          "expect": {
            "return": {
              "C": {
                "남": 10.0,
                "여": 20.0
              }
            }
          },
          "compare": {
            "mode": "float",
            "tol": 1e-09
          }
        }
      ],
      "hints": [
        "`df.pivot_table(index=\"반\", columns=\"성별\", values=\"점수\", aggfunc=\"mean\").round(1)`.",
        "행마다 `iterrows()`로 돌며 안쪽 딕셔너리를 만들고, `pd.isna(값)`이면 `None`을 넣으세요."
      ],
      "solution": "import pandas as pd\n\n\ndef pivot(data):\n    df = pd.DataFrame(data)\n    table = df.pivot_table(index=\"반\", columns=\"성별\", values=\"점수\", aggfunc=\"mean\").round(1)\n    result = {}\n    for cls, row in table.iterrows():\n        result[cls] = {col: (None if pd.isna(v) else float(v)) for col, v in row.items()}\n    return result\n",
      "time_limit_sec": 15
    }
  ]
