          }
        },
        {
          "id": "h1",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              {
                "이름": [
                  "x"
                ],
                "점수": [
                  0
                ]
              }
            ]
          },
          "expect": {
            "return": "x"
          }
