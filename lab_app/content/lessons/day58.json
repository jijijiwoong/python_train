      "starter_code": "import pandas as pd\n\n\ndef names_over(data, cut):\n    df = pd.DataFrame(data)\n    return df.____[df[\"점수\"] >= cut, \"____\"].tolist()\n",
      "entry": {
        "mode": "function",
