      ],
      "solution": "import pandas as pd\n\n\ndef names_over(data, cut):\n    df = pd.DataFrame(data)\n    return df.loc[df[\"점수\"] >= cut, \"이름\"].tolist()\n",
      "time_limit_sec": 15
