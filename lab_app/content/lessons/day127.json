    {
      "id": "d127_fill_1",
      "kind": "fill_blank",
      "title": "매개변수 세기",
      "prompt_md": "`sizes`가 `[4, 8, 3]`이면 `nn.Linear(4, 8)`, `nn.Linear(8, 3)`처럼 이웃한 수로 층을 만들고 전체 매개변수 수를 반환하세요.",
      "concepts": [
        "nn_linear"
      ],
      "difficulty": 1,
      "required": true,
      "starter_code": "from torch import nn\n\n\ndef param_count(sizes):\n    layers = [nn.____(a, b) for a, b in zip(sizes, sizes[1:])]\n    return sum(p.____() for layer in layers for p in layer.parameters())\n",
      "entry": {
        "mode": "function",
        "name": "param_count"
      },
      "tests": [
        {
          "id": "t1",
          "hidden": false,
          "description": "기본",
