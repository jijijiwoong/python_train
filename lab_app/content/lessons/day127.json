              [
                4,
                8,
                3
              ]
            ]
          },
          "expect": {
            "return": 67
          }
        },
        {
          "id": "h1",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              [
                2,
                1
              ]
            ]
          },
          "expect": {
            "return": 3
          }
        },
        {
          "id": "h2",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              [
                10,
                20,
                20,
                5
              ]
            ]
          },
          "expect": {
            "return": 745
          }
        }
      ],
      "hints": [
        "선형 층 클래스 이름입니다.",
        "텐서의 원소 수를 돌려주는 메서드입니다."
      ],
      "solution": "from torch import nn\n\n\ndef param_count(sizes):\n    layers = [nn.Linear(a, b) for a, b in zip(sizes, sizes[1:])]\n    return sum(p.numel() for layer in layers for p in layer.parameters())\n",
      "time_limit_sec": 60
    },
    {
      "id": "d127_code_1",
      "kind": "coding",
      "title": "순전파 확인",
      "prompt_md": "`torch.manual_seed(seed)` 후 `nn.Linear(2, 1)`을 만들고 입력 `rows`에 대해 ① 층 호출 결과와 ② `x @ weight.T + bias`를 직접 계산하세요. `[층 결과를 펼친 리스트(소수 넷째 자리), 두 결과가 같은지(torch.allclose)]`를 반환합니다.",
      "concepts": [
        "nn_linear"
      ],
      "difficulty": 2,
      "required": true,
      "starter_code": "import torch\nfrom torch import nn\n\n\ndef check_forward(seed, rows):\n    # 여기에 코드를 작성하세요\n    pass\n",
      "entry": {
        "mode": "function",
        "name": "check_forward"
      },
      "tests": [
        {
          "id": "t1",
          "hidden": false,
          "description": "기본",
          "call": {
            "args": [
              0,
              [
                [
                  1,
                  2
                ],
                [
                  3,
                  4
                ]
              ]
            ]
          },
          "expect": {
            "return": [
              [
                0.1714,
                0.9194
              ],
              true
            ]
          },
          "compare": {
            "mode": "float",
            "tol": 0.0001
          }
        },
        {
          "id": "h1",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              7,
              [
                [
                  0,
                  0
                ],
                [
                  1,
                  -1
                ],
                [
                  2,
                  5
                ]
              ]
            ]
          },
          "expect": {
            "return": [
              [
                0.2252,
                0.7005,
                -1.8058
              ],
              true
            ]
          },
          "compare": {
            "mode": "float",
            "tol": 0.0001
          }
        }
      ],
      "hints": [
        "층을 함수처럼 부르면 순전파 결과가 나옵니다.",
        "가중치는 (출력, 입력) 모양이라 `.T`로 뒤집어 곱합니다."
      ],
      "solution": "import torch\nfrom torch import nn\n\n\ndef check_forward(seed, rows):\n    torch.manual_seed(seed)\n    layer = nn.Linear(2, 1)\n    x = torch.tensor(rows, dtype=torch.float32)\n    out = layer(x)\n    manual = x @ layer.weight.T + layer.bias\n    return [[round(v, 4) for v in out.flatten().tolist()], torch.allclose(out, manual)]\n",
      "time_limit_sec": 60
    }
  ]
