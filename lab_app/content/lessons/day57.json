          "expect": {
            "return": [
              3,
              2
            ]
          }
        },
        {
          "id": "h1",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              {
                "x": [
                  1
                ]
              }
            ]
          },
          "expect": {
            "return": [
              1,
              1
            ]
          }
        }
      ],
      "hints": [
        "표를 만드는 pandas 클래스 이름입니다.",
        "(행 수, 열 수) 튜플을 담은 속성입니다."
      ],
      "solution": "import pandas as pd\n\n\ndef table_shape(data):\n    df = pd.DataFrame(data)\n    return list(df.shape)\n",
      "time_limit_sec": 15
    },
    {
      "id": "d57_code_1",
      "kind": "coding",
      "title": "표 요약",
      "prompt_md": "열 이름 → 값 목록 딕셔너리를 DataFrame으로 만들고 다음을 반환하세요.\n\n- `rows`: 행 수, `cols`: 열 이름 리스트\n- `means`: **숫자 열**의 평균(소수 둘째 자리 반올림) 딕셔너리\n\n숫자 열만 평균을 내려면 `df.mean(numeric_only=True)`를 쓰세요.",
      "concepts": [
        "pandas_basics"
      ],
      "difficulty": 2,
      "required": true,
      "starter_code": "import pandas as pd\n\n\ndef summary(data):\n    # 여기에 코드를 작성하세요\n    pass\n",
      "entry": {
        "mode": "function",
        "name": "summary"
      },
      "tests": [
        {
          "id": "t1",
          "hidden": false,
          "description": "학생 표",
          "call": {
            "args": [
              {
                "이름": [
                  "민준",
                  "서연",
                  "지호",
                  "하나",
                  "도윤"
                ],
                "반": [
                  "A",
                  "B",
                  "A",
                  "B",
                  "A"
                ],
                "국어": [
                  85,
                  92,
                  78,
                  66,
                  90
                ],
                "수학": [
                  70,
                  88,
                  95,
                  72,
                  60
                ]
              }
            ]
          },
          "expect": {
            "return": {
              "rows": 5,
              "cols": [
                "이름",
                "반",
                "국어",
                "수학"
              ],
              "means": {
                "국어": 82.2,
                "수학": 77.0
              }
            }
          },
          "compare": {
            "mode": "float",
            "tol": 1e-09
          }
        },
        {
          "id": "h1",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              {
                "x": [
                  1,
                  2
                ],
                "y": [
                  3.5,
                  4.5
                ],
                "z": [
                  "a",
                  "b"
                ]
              }
