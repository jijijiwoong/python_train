                "y": 4.0
              }
            }
          },
          "compare": {
            "mode": "float",
            "tol": 1e-09
          }
        },
        {
          "id": "h2",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              {
                "v": [
                  10
                ]
              }
            ]
          },
          "expect": {
            "return": {
              "rows": 1,
              "cols": [
                "v"
              ],
              "means": {
                "v": 10.0
              }
            }
          },
          "compare": {
            "mode": "float",
            "tol": 1e-09
          }
        }
      ],
      "hints": [
        "`len(df)`는 행 수, `list(df.columns)`는 열 이름입니다.",
        "`df.mean(numeric_only=True).round(2)`는 Series이고, `.to_dict()`로 딕셔너리가 됩니다."
      ],
      "solution": "import pandas as pd\n\n\ndef summary(data):\n    df = pd.DataFrame(data)\n    means = df.mean(numeric_only=True).round(2)\n    return {\"rows\": len(df), \"cols\": list(df.columns), \"means\": means.to_dict()}\n",
