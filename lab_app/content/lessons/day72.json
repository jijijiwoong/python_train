      "tests": [
        {
          "id": "t1",
          "hidden": false,
          "description": "3품종",
          "call": {
            "args": []
          },
          "expect": {
            "return": {
              "setosa": [
                5.01,
                3.43,
                1.46,
                0.25
              ],
              "versicolor": [
                5.94,
                2.77,
                4.26,
                1.33
              ],
              "virginica": [
                6.59,
                2.97,
                5.55,
                2.03
              ]
            }
          },
          "compare": {
            "mode": "float",
            "tol": 1e-09
          }
        }
      ],
      "hints": [
        "`iris.data[iris.target == i]`로 i번 품종의 행만 고르세요.",
        "고른 행의 `mean(axis=0)`이 특성별 평균입니다.",
        "`enumerate(iris.target_names)`로 번호와 이름을 함께 돌면 편합니다."
      ],
      "solution": "import numpy as np\nfrom sklearn.datasets import load_iris\n\n\ndef class_means():\n    iris = load_iris()\n    result = {}\n    for i, name in enumerate(iris.target_names):\n        rows = iris.data[iris.target == i]\n        result[str(name)] = np.round(rows.mean(axis=0), 2).tolist()\n    return result\n",
      "time_limit_sec": 30
    }
