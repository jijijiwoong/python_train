                  29.6,
                  1.9
                ],
                [
                  44.9,
                  78.8,
                  9.9
                ],
                [
                  35.2,
                  49.7,
                  25.1
                ]
              ],
              "silhouette": 0.7704
            }
          },
          "compare": {
            "mode": "float",
            "tol": 1e-06
          }
        },
        {
          "id": "h1",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              2
            ]
          },
          "expect": {
            "return": {
              "sizes": [
                70,
                60
              ],
              "means": [
                [
                  40.8,
                  66.3,
                  16.4
                ],
                [
                  18.9,
                  29.6,
                  1.9
                ]
              ],
              "silhouette": 0.6773
            }
          },
          "compare": {
            "mode": "float",
            "tol": 1e-06
          }
        }
      ],
      "hints": [
        "표준화 데이터로 군집, 원래 데이터로 평균을 계산합니다.",
        "크기 `np.bincount(labels)`를 큰 순으로 정렬한 위치(`np.argsort(...)[::-1]`)를 구하세요.",
        "그 순서대로 `X[labels == c].mean(axis=0)`."
      ],
      "solution": "import numpy as np\nfrom sklearn.cluster import KMeans\nfrom sklearn.metrics import silhouette_score\n\ndef customer_data():\n    rng = np.random.default_rng(7)\n    a = rng.normal([20, 30, 2], [3, 5, 1], size=(60, 3))\n    b = rng.normal([45, 80, 10], [5, 8, 2], size=(40, 3))\n    c = rng.normal([35, 50, 25], [4, 6, 3], size=(30, 3))\n    return np.vstack([a, b, c])\n\n\ndef segment(k):\n    X = customer_data()\n    Xs = (X - X.mean(axis=0)) / X.std(axis=0)\n    labels = KMeans(n_clusters=k, n_init=10, random_state=0).fit_predict(Xs)\n    sizes = np.bincount(labels)\n    order = np.argsort(sizes)[::-1]\n    means = [np.round(X[labels == c].mean(axis=0), 1).tolist() for c in order]\n    return {\n        \"sizes\": sizes[order].tolist(),\n        \"means\": means,\n        \"silhouette\": round(float(silhouette_score(Xs, labels)), 4),\n    }\n",
      "time_limit_sec": 60
    },
    {
      "id": "d112_code_2",
      "kind": "coding",
      "title": "[도전] k-평균 한 단계",
      "prompt_md": "점 목록과 중심 목록을 받아 k-평균 한 단계를 수행하세요. ① 각 점을 거리 제곱이 가장 작은 중심에 배정 ② 중심을 배정된 점들의 평균으로 이동(배정된 점이 없으면 그대로). `[배정 리스트, 새 중심(소수 셋째 자리)]`를 반환합니다.",
      "concepts": [
