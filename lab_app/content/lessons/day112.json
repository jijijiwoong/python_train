        {
          "id": "h1",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              [
                [
                  1,
                  1
                ],
                [
                  2,
                  2
                ],
                [
                  9,
                  9
                ]
              ],
              [
                [
                  0,
                  0
                ],
                [
                  10,
                  10
                ]
              ]
            ]
          },
          "expect": {
            "return": [
              [
                0,
                0,
                1
              ],
              [
                [
                  1.5,
                  1.5
                ],
                [
                  9.0,
                  9.0
                ]
              ]
            ]
          },
          "compare": {
            "mode": "float",
            "tol": 1e-06
          }
        }
      ],
      "hints": [
        "`((P[:, None, :] - C[None, :, :]) ** 2).sum(axis=2)`는 (점 수, 중심 수) 거리 행렬입니다.",
        "`argmin(axis=1)`로 배정, 중심 j는 `P[labels == j].mean(axis=0)`."
      ],
      "solution": "import numpy as np\n\n\ndef kmeans_step(points, centers):\n    P = np.array(points, dtype=float)\n    C = np.array(centers, dtype=float)\n    distances = ((P[:, None, :] - C[None, :, :]) ** 2).sum(axis=2)\n    labels = distances.argmin(axis=1)\n    new_centers = []\n    for j in range(len(C)):\n        members = P[labels == j]\n        new_centers.append(members.mean(axis=0) if len(members) else C[j])\n    return [labels.tolist(), np.round(np.array(new_centers), 3).tolist()]\n",
      "time_limit_sec": 60
    }
  ]
