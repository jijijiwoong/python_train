          "expect": {
            "return": [
              [
                0,
                0,
                0
              ],
              [
                0,
                0,
                0
              ],
              [
                0,
                0,
                0
              ]
            ]
          }
        }
      ],
      "hints": [
        "`np.pad(g, 1)`로 테두리를 0으로 두르면 모든 칸이 8개의 이웃을 가집니다.",
        "이웃 수는 패딩된 배열에서 8방향으로 한 칸씩 옮긴 부분 배열(슬라이싱)들을 더해 구할 수 있습니다.",
        "규칙은 `(이웃 == 3) | ((g == 1) & (이웃 == 2))`이고, `astype(int)`로 0/1로 바꿉니다."
      ],
      "solution": "import numpy as np\n\n\ndef next_generation(grid):\n    g = np.array(grid)\n    p = np.pad(g, 1)\n    rows, cols = g.shape\n    neighbors = np.zeros_like(g)\n    for dr in (-1, 0, 1):\n        for dc in (-1, 0, 1):\n            if (dr, dc) != (0, 0):\n                neighbors += p[1 + dr:1 + dr + rows, 1 + dc:1 + dc + cols]\n    alive = (neighbors == 3) | ((g == 1) & (neighbors == 2))\n    return alive.astype(int)\n",
      "time_limit_sec": 10
    }
  ]
