              "A": 3,
              "B": 1
            }
          }
        },
        {
          "id": "h1",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              {
                "반": [
                  "X"
                ]
              }
            ]
          },
          "expect": {
            "return": {
              "X": 1
            }
          }
        }
      ],
      "hints": [
        "값별 개수를 세는 Series 메서드입니다.",
        "Series를 딕셔너리로 바꾸는 메서드입니다."
      ],
      "solution": "import pandas as pd\n\n\ndef class_counts(data):\n    df = pd.DataFrame(data)\n    return df[\"반\"].value_counts().to_dict()\n",
      "time_limit_sec": 20
    },
    {
      "id": "d67_code_1",
      "kind": "coding",
      "title": "데이터 프로필",
      "prompt_md": "데이터를 받아 다음을 담은 딕셔너리를 반환하세요.\n\n- `rows`: 행 수\n- `numeric`: 숫자 열마다 `{\"mean\": 평균(소수 둘째 자리), \"min\": 최솟값, \"max\": 최댓값}` (값은 float)\n- `top`: 숫자가 아닌 열마다 가장 많이 나온 값",
      "concepts": [
        "eda",
        "pandas_basics"
      ],
      "difficulty": 2,
      "required": true,
      "starter_code": "import pandas as pd\n\n\ndef profile(data):\n    # 여기에 코드를 작성하세요\n    pass\n",
      "entry": {
        "mode": "function",
        "name": "profile"
      },
      "tests": [
        {
          "id": "t1",
          "hidden": false,
          "description": "학생 표",
          "call": {
            "args": [
              {
                "이름": [
                  "민준",
                  "서연",
                  "지호",
                  "하나"
                ],
                "반": [
                  "A",
                  "B",
                  "A",
                  "A"
                ],
                "키": [
                  172.5,
                  160.0,
                  181.0,
                  158.5
                ],
                "점수": [
                  85,
                  92,
                  78,
                  66
                ]
              }
            ]
          },
          "expect": {
            "return": {
              "rows": 4,
              "numeric": {
                "키": {
                  "mean": 168.0,
                  "min": 158.5,
                  "max": 181.0
                },
                "점수": {
                  "mean": 80.25,
                  "min": 66.0,
                  "max": 92.0
                }
              },
              "top": {
                "이름": "민준",
                "반": "A"
              }
            }
          },
          "compare": {
            "mode": "float",
            "tol": 1e-09
          }
        },
        {
          "id": "h1",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              {
                "x": [
                  1,
                  3
                ],
                "y": [
                  "a",
                  "a"
                ]
              }
            ]
          },
          "expect": {
            "return": {
              "rows": 2,
              "numeric": {
                "x": {
                  "mean": 2.0,
                  "min": 1.0,
                  "max": 3.0
                }
              },
              "top": {
                "y": "a"
              }
            }
          },
          "compare": {
            "mode": "float",
            "tol": 1e-09
          }
        }
      ],
      "hints": [
        "숫자 열은 `df.select_dtypes(\"number\").columns`, 그 밖은 `select_dtypes(exclude=\"number\")`.",
        "가장 많이 나온 값은 `value_counts().index[0]`입니다.",
        "숫자는 `float()`로 바꿔 넣으세요."
      ],
      "solution": "import pandas as pd\n\n\ndef profile(data):\n    df = pd.DataFrame(data)\n    numeric = {}\n    for col in df.select_dtypes(\"number\").columns:\n        numeric[col] = {\n            \"mean\": round(float(df[col].mean()), 2),\n            \"min\": float(df[col].min()),\n            \"max\": float(df[col].max()),\n        }\n    top = {}\n    for col in df.select_dtypes(exclude=\"number\").columns:\n        top[col] = df[col].value_counts().index[0]\n    return {\"rows\": len(df), \"numeric\": numeric, \"top\": top}\n",
      "time_limit_sec": 20
    }
  ]
