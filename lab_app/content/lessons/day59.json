  "exercises": [
    {
      "id": "d59_fill_1",
      "kind": "fill_blank",
      "title": "총점 순위",
      "prompt_md": "국어·수학 점수로 `총점` 열을 만들고, 총점 높은 순으로 정렬한 **이름 리스트**를 반환하세요.",
      "concepts": [
        "pandas_transform"
      ],
      "difficulty": 1,
      "required": true,
      "starter_code": "import pandas as pd\n\n\ndef ranking(data):\n    df = pd.DataFrame(data)\n    df[\"총점\"] = df[\"국어\"] ____ df[\"수학\"]\n    return df.sort_values(\"총점\", ascending=____)[\"이름\"].tolist()\n",
      "entry": {
        "mode": "function",
        "name": "ranking"
      },
      "tests": [
        {
          "id": "t1",
          "hidden": false,
          "description": "기본",
          "call": {
            "args": [
              {
                "이름": [
                  "민준",
                  "서연",
                  "지호",
                  "하나"
                ],
                "국어": [
                  85,
                  92,
                  78,
                  60
                ],
                "수학": [
                  95,
                  88,
                  61,
                  70
                ]
              }
            ]
          },
          "expect": {
            "return": [
              "민준",
              "서연",
              "지호",
              "하나"
            ]
          }
        },
        {
          "id": "h1",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              {
                "이름": [
                  "a",
                  "b"
                ],
                "국어": [
                  0,
                  1
                ],
                "수학": [
                  0,
                  0
                ]
              }
            ]
          },
          "expect": {
