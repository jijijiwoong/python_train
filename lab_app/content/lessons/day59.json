              "b",
              "a"
            ]
          }
        }
      ],
      "hints": [
        "두 열을 더하는 연산자입니다.",
        "높은 순(내림차순)이 되도록 오름차순 여부를 정하세요."
      ],
      "solution": "import pandas as pd\n\n\ndef ranking(data):\n    df = pd.DataFrame(data)\n    df[\"총점\"] = df[\"국어\"] + df[\"수학\"]\n    return df.sort_values(\"총점\", ascending=False)[\"이름\"].tolist()\n",
      "time_limit_sec": 15
    },
    {
      "id": "d59_code_1",
      "kind": "coding",
      "title": "평균과 학점",
      "prompt_md": "국어·수학 점수로 `평균`(소수 첫째 자리 반올림)과 `학점`(90 이상 A, 80 이상 B, 70 이상 C, 그 외 F) 열을 만드세요. 평균 높은 순(같으면 이름 순)으로 정렬해 `이름`, `평균`, `학점` 세 열만 `to_dict(\"records\")`로 반환하세요.",
      "concepts": [
        "pandas_transform",
        "lambda",
        "conditional_expr"
      ],
      "difficulty": 2,
      "required": true,
      "starter_code": "import pandas as pd\n\n\ndef add_grades(data):\n    # 여기에 코드를 작성하세요\n    pass\n",
      "entry": {
        "mode": "function",
        "name": "add_grades"
      },
      "tests": [
        {
          "id": "t1",
          "hidden": false,
          "description": "기본",
          "call": {
            "args": [
              {
                "이름": [
                  "민준",
                  "서연",
                  "지호",
                  "하나"
                ],
                "국어": [
                  85,
                  92,
                  78,
                  60
                ],
                "수학": [
                  95,
                  88,
                  61,
                  70
                ]
              }
            ]
          },
          "expect": {
            "return": [
              {
                "이름": "민준",
                "평균": 90.0,
                "학점": "A"
              },
              {
                "이름": "서연",
                "평균": 90.0,
                "학점": "A"
              },
              {
                "이름": "지호",
                "평균": 69.5,
                "학점": "F"
              },
              {
                "이름": "하나",
                "평균": 65.0,
                "학점": "F"
              }
            ]
          },
          "compare": {
            "mode": "float",
            "tol": 1e-09
          }
        },
        {
          "id": "h1",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              {
                "이름": [
                  "민준",
                  "서연",
                  "지호",
                  "하나",
                  "도윤"
                ],
                "반": [
                  "A",
                  "B",
                  "A",
                  "B",
                  "A"
                ],
                "국어": [
                  85,
                  92,
                  78,
                  66,
                  90
                ],
                "수학": [
                  70,
                  88,
                  95,
                  72,
                  60
                ]
              }
            ]
          },
          "expect": {
            "return": [
              {
                "이름": "서연",
                "평균": 90.0,
                "학점": "A"
              },
              {
                "이름": "지호",
                "평균": 86.5,
                "학점": "B"
              },
              {
                "이름": "민준",
                "평균": 77.5,
                "학점": "C"
              },
              {
                "이름": "도윤",
                "평균": 75.0,
                "학점": "C"
              },
              {
                "이름": "하나",
                "평균": 69.0,
                "학점": "F"
              }
            ]
          },
          "compare": {
            "mode": "float",
            "tol": 1e-09
          }
        }
      ],
      "hints": [
        "평균 열은 `((국어 + 수학) / 2).round(1)`.",
        "학점은 평균 열에 `apply`로 함수(또는 lambda)를 적용합니다.",
        "`sort_values([\"평균\", \"이름\"], ascending=[False, True])` 후 `df[[\"이름\", \"평균\", \"학점\"]].to_dict(\"records\")`."
      ],
      "solution": "import pandas as pd\n\n\ndef to_grade(m):\n    if m >= 90:\n        return \"A\"\n    if m >= 80:\n        return \"B\"\n    if m >= 70:\n        return \"C\"\n    return \"F\"\n\n\ndef add_grades(data):\n    df = pd.DataFrame(data)\n    df[\"평균\"] = ((df[\"국어\"] + df[\"수학\"]) / 2).round(1)\n    df[\"학점\"] = df[\"평균\"].apply(to_grade)\n    df = df.sort_values([\"평균\", \"이름\"], ascending=[False, True])\n    return df[[\"이름\", \"평균\", \"학점\"]].to_dict(\"records\")\n",
      "time_limit_sec": 15
    }
  ]
