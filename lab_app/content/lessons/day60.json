  "exercises": [
    {
      "id": "d60_fill_1",
      "kind": "fill_blank",
      "title": "평균으로 채우기",
      "prompt_md": "`점수` 열의 빈 값(None)을 그 열의 평균으로 채운 점수 리스트를 반환하세요.",
      "concepts": [
        "pandas_missing"
      ],
      "difficulty": 1,
      "required": true,
      "starter_code": "import pandas as pd\n\n\ndef fill_scores(data):\n    df = pd.DataFrame(data)\n    df[\"점수\"] = df[\"점수\"].____(df[\"점수\"].____())\n    return df[\"점수\"].tolist()\n",
      "entry": {
        "mode": "function",
        "name": "fill_scores"
      },
      "tests": [
        {
          "id": "t1",
          "hidden": false,
          "description": "하나 비어 있음",
          "call": {
            "args": [
              {
                "점수": [
                  80,
                  null,
                  100
                ]
              }
            ]
          },
          "expect": {
            "return": [
              80.0,
              90.0,
              100.0
            ]
          }
        },
        {
          "id": "h1",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              {
                "점수": [
                  1,
                  2
                ]
              }
            ]
          },
          "expect": {
            "return": [
              1,
              2
            ]
          }
        }
      ],
      "hints": [
        "빈 값을 채우는 메서드입니다.",
        "평균을 구하는 메서드입니다."
      ],
      "solution": "import pandas as pd\n\n\ndef fill_scores(data):\n    df = pd.DataFrame(data)\n    df[\"점수\"] = df[\"점수\"].fillna(df[\"점수\"].mean())\n    return df[\"점수\"].tolist()\n",
      "time_limit_sec": 15
    },
    {
      "id": "d60_code_1",
      "kind": "coding",
      "title": "데이터 청소",
      "prompt_md": "이름·국어·수학 열이 있는 데이터를 정리하세요.\n\n1. `이름`이 비어 있는 행은 지웁니다.\n2. 남은 행에서 국어·수학의 빈 값 개수를 셉니다.\n3. 국어·수학의 빈 값을 **각 열의 중앙값**(남은 행 기준)으로 채웁니다.\n\n`[정리된 표의 to_dict(\"records\"), 채운 칸 수]`를 반환하세요.",
      "concepts": [
        "pandas_missing",
        "pandas_select"
      ],
      "difficulty": 2,
      "required": true,
      "starter_code": "import pandas as pd\n\n\ndef clean(data):\n    # 여기에 코드를 작성하세요\n    pass\n",
      "entry": {
        "mode": "function",
        "name": "clean"
      },
      "tests": [
        {
          "id": "t1",
          "hidden": false,
          "description": "여러 결측치",
          "call": {
            "args": [
              {
                "이름": [
                  "민준",
                  null,
                  "지호",
                  "하나",
                  "도윤"
                ],
                "국어": [
                  85,
                  90,
                  null,
                  66,
                  70
                ],
                "수학": [
                  70,
                  88,
                  95,
                  null,
                  null
                ]
              }
            ]
          },
          "expect": {
            "return": [
              [
                {
                  "이름": "민준",
                  "국어": 85.0,
                  "수학": 70.0
                },
                {
                  "이름": "지호",
                  "국어": 70.0,
                  "수학": 95.0
                },
                {
                  "이름": "하나",
                  "국어": 66.0,
                  "수학": 82.5
                },
                {
                  "이름": "도윤",
                  "국어": 70.0,
                  "수학": 82.5
                }
              ],
              3
            ]
          },
          "compare": {
            "mode": "float",
            "tol": 1e-09
          }
        },
        {
          "id": "h1",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              {
                "이름": [
                  "a",
                  "b"
                ],
                "국어": [
                  null,
                  4
                ],
                "수학": [
                  1,
                  3
                ]
              }
            ]
          },
          "expect": {
            "return": [
              [
                {
                  "이름": "a",
                  "국어": 4.0,
                  "수학": 1
                },
                {
                  "이름": "b",
                  "국어": 4.0,
                  "수학": 3
                }
              ],
              1
            ]
          },
          "compare": {
            "mode": "float",
            "tol": 1e-09
          }
        }
      ],
      "hints": [
        "`df.dropna(subset=[\"이름\"])`로 이름 없는 행을 먼저 지우세요.",
        "채우기 전에 `df[[\"국어\", \"수학\"]].isna().sum().sum()`으로 빈 칸 수를 셉니다(`int()`로 바꾸기).",
        "열마다 `df[열] = df[열].fillna(df[열].median())`."
      ],
      "solution": "import pandas as pd\n\n\ndef clean(data):\n    df = pd.DataFrame(data)\n    df = df.dropna(subset=[\"이름\"])\n    filled = int(df[[\"국어\", \"수학\"]].isna().sum().sum())\n    for col in [\"국어\", \"수학\"]:\n        df[col] = df[col].fillna(df[col].median())\n    return [df.to_dict(\"records\"), filled]\n",
      "time_limit_sec": 15
    }
  ]
}
