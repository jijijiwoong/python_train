  "exercises": [
    {
      "id": "d07_fill_1",
      "kind": "fill_blank",
      "title": "배수의 개수",
      "prompt_md": "1부터 `n`까지의 정수 중 `k`의 배수가 몇 개인지 **반환**하는 함수 `count_multiples(n, k)`를 완성하세요.\n\n예: `count_multiples(10, 3)` → `3` (3, 6, 9)",
      "concepts": [
        "function",
        "return",
        "for_loop",
        "condition",
        "accumulation"
      ],
      "difficulty": 2,
      "required": true,
      "starter_code": "def count_multiples(n, k):\n    count = 0\n    for i in range(1, n ____ 1):\n        if i % k == 0:\n            count ____ 1\n    return count\n",
      "entry": {
        "mode": "function",
        "name": "count_multiples"
      },
      "tests": [
        {
          "id": "t1",
          "hidden": false,
          "description": "(10, 3)",
          "call": {
            "args": [
              10,
              3
            ]
          },
          "expect": {
            "return": 3
          }
        },
        {
          "id": "h1",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              1,
              1
            ]
          },
          "expect": {
            "return": 1
          }
        },
        {
          "id": "h2",
          "hidden": true,
          "description": "",
          "call": {
            "args": [
              20,
              5
            ]
          },
          "expect": {
            "return": 4
          }
        },
        {
          "id": "h3",
          "hidden": true,
          "description": "",
          "call": {
