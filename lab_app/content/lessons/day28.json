      "concepts": [
        "recursion",
        "list"
      ],
      "difficulty": 3,
      "required": false,
      "starter_code": "def flatten(items):\n    # 여기에 코드를 작성하세요\n    pass\n",
      "entry": {
        "mode": "function",
        "name": "flatten"
      },
      "tests": [
        {
          "id": "t1",
          "hidden": false,
          "description": "중첩",
          "call": {
            "args": [
              [
                1,
                [
                  2,
                  [
                    3,
                    4
                  ]
                ],
                5
              ]
            ]
